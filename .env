# VenusX AI Scanner Configuration

# Server
SCANNER_HOST=0.0.0.0
SCANNER_PORT=5000
SCANNER_DEBUG=true

# YOLO Model - first tries ml_models/best.pt, then falls back to yolov8n.pt
YOLO_MODEL_PATH=ml_models/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_DEVICE=cpu
YOLO_USE_COCO_FALLBACK=true
YOLO_COCO_MODEL=yolov8n.pt

# Barcode Scanner
BARCODE_ENABLED=true

# VenusX API (product lookup) - the Go backend
VENUSX_API_URL=http://localhost:8080
VENUSX_API_TIMEOUT=5

# CORS
CORS_ALLOWED_ORIGINS=*

# COCO Product Mapping: maps COCO class IDs to product barcodes
# Format: "class_id:barcode,class_id:barcode,..."
# Example - map bottle(39) to a Fanta barcode, apple(47) to a manzana barcode:
# COCO_PRODUCT_MAP=39:8412345678901,47:8423456789012
COCO_PRODUCT_MAP=
